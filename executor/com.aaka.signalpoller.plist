<?xml version="1.0" encoding="UTF-8"?>
<!-- Templated by admin/deploy.sh: ${PYTHON_BIN} ${AAKA_BASE} ${AAKA_CONFIG_DIR}
     ${SIGNAL_ACCOUNT} are substituted at install time.

     Consumes the signal-cli SSE stream and dispatches to sensor/router_sensor.py,
     the Signal counterpart of the Telegram poller. Installed on the Mac only
     when SIGNAL_PLACEMENT=executor; the default deployment runs
     deploy/aaka-signal-poller.service on the VPS instead. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aaka.signalpoller</string>

  <key>ProgramArguments</key>
  <array>
    <string>${PYTHON_BIN}</string>
    <string>-u</string>
    <string>${AAKA_BASE}/sensor/signal_poller.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>${AAKA_BASE}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AAKA_CONFIG_DIR</key>
    <string>${AAKA_CONFIG_DIR}</string>
    <key>AAKA_BASE</key>
    <string>${AAKA_BASE}</string>
    <key>ENABLED_CHANNELS</key>
    <string>telegram,signal</string>
    <key>SIGNAL_CLI_URL</key>
    <string>http://127.0.0.1:18794</string>
    <key>SIGNAL_ACCOUNT</key>
    <string>${SIGNAL_ACCOUNT}</string>
    <key>SIGNAL_PLACEMENT</key>
    <string>executor</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>${AAKA_CONFIG_DIR}/logs/signal_poller.log</string>

  <key>StandardErrorPath</key>
  <string>${AAKA_CONFIG_DIR}/logs/signal_poller.log</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
