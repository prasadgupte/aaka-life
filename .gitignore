**/__pycache__/
*.pyc
.env
# Per-user secrets never belong in the repo. NOTE: config/credentials.json is
# intentionally committed — it's the *bundled community OAuth client* (Desktop
# app, not confidential per RFC 8252) so users can auth against the shared app
# without their own GCP project. Per-user tokens live in $AAKA_CONFIG_DIR/tokens
# (external) and must never be committed.
**/token*.json
*.pem
*.key
*.db
*.sqlite3
.DS_Store
zeroclaw/config.toml
zeroclaw/workspace/
node_modules/
*.egg-info/
dist/
build/
tmp/
tmp/*.*
samples/demo/data/queue/
samples/demo/logs/
# Regenerated by samples/demo/refresh.py on every webui startup — drifts
# daily. refresh.py + its WEEK/TASKS templates are the source of truth.
samples/demo/data/calendar/
samples/demo/data/tasks/
samples/demo/data/engagement/
venv/

# Website — lives in its own repo (aaka-site)
site/
admin/deploy-site.sh

