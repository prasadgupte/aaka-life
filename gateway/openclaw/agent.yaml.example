# OpenClaw agent config template
# Copy to ~/.openclaw/agent.yaml — never commit real values.

id: aaka-away
name: Aaka Away
workspace: ${AAKA_BASE}
agentDir: sensor
model:
  primary: router/router
  fallbacks: []
identity: SOUL.md

channels:
  telegram:
    botToken: "${TELEGRAM_BOT_TOKEN}"

bindings:
  - channel: whatsapp
    type: group
    id: "${WHATSAPP_GROUP_JID}"
    require_mention: false

  - channel: whatsapp
    type: dm
    id: "${WHATSAPP_PHONE}"
    require_mention: false

  - channel: telegram
    type: dm
    id: "${TELEGRAM_USER_ID}"
    require_mention: false

  - channel: telegram
    type: group
    id: "${TELEGRAM_GROUP_ID}"
    require_mention: false

# Restricted tool list: queue writes only, no calendar/CSV side-effects
tools:
  - name: write_queue_item
    description: Write an extracted intent payload to the local SQLite queue for Executor processing
    type: skill_run
    skill: queue_write
  - name: read_queue_status
    description: Read the current status of a queued item
    type: skill_run
    skill: queue_status

# Read reactions: 👀 sent via Telegram setMessageReaction in router_sensor.py.
# No OpenClaw config needed — handled in Python at message receipt.

# Backend: router_sensor.py handles everything via agentDir convention
input: arg
# NOTE: no 'script:' field — router/router + input:arg routes via agentDir
