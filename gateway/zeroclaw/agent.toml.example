# ZeroClaw agent config template
# Copy to ~/.zeroclaw/config.toml (or path set by ZEROCLAW_CONFIG env var)
# Fill in secrets — never commit this file with real values.

[gateway]
port = 18789

[providers.gemini]
api_key = "${GEMINI_API_KEY}"
model   = "gemini-2.5-flash-lite"   # adjust to desired model

[bindings]
# Telegram bot — token is portable across machines
[[bindings.telegram]]
type  = "bot"
token = "${TELEGRAM_BOT_TOKEN}"

# WhatsApp group — requires QR scan on this machine
[[bindings.whatsapp]]
type  = "group"
jid   = "${WHATSAPP_GROUP_JID}"

[[bindings.whatsapp]]
type  = "dm"
phone = "${WHATSAPP_PHONE}"

[agent]
# The agent receives each message and passes it to this command.
# router_sensor.py reads from stdin or argv and writes the reply to stdout.
input  = "arg"
script = "python3 sensor/router_sensor.py"
