{
  "_comment": "This is the template for the Aaka community OAuth app. The real credentials.json (committed at config/credentials.json) is used automatically by admin/reauth.py — you don't need this file unless you want to use your own GCP project. To use your own: fill in client_id and client_secret from GCP Console → Credentials → OAuth 2.0 Client ID (Desktop app), then save as $AAKA_CONFIG_DIR/tokens/credentials.json.",
  "installed": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "project_id": "your-project-id",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_secret": "YOUR_CLIENT_SECRET",
    "redirect_uris": ["http://localhost"]
  }
}
